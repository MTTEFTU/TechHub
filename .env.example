# Copy to .env in the repository root. Never commit actual credentials.
MONGODB_URI=replace-with-mongodb-connection-string
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=4000
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express only. Dev Dashboard client credentials are exchanged for expiring Admin
# tokens automatically. Do not set SHOPIFY_ADMIN_ACCESS_TOKEN or use NEXT_PUBLIC_.
# The app must be installed on a store in the same Shopify organization.
# The existing PUBLIC Storefront token is sent with
# X-Shopify-Storefront-Access-Token; do not supply a private Storefront token here.
SHOPIFY_STORE_DOMAIN=replace-with-store-name.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-public-storefront-access-token
SHOPIFY_CLIENT_ID=replace-with-tech-hub-integration-client-id
SHOPIFY_CLIENT_SECRET=replace-with-tech-hub-integration-client-secret
SHOPIFY_WEBHOOK_SECRET=replace-with-existing-app-webhook-signing-secret
SHOPIFY_API_VERSION=2026-07
SHOPIFY_COD_COUNTRY_CODE=BD

# Express calls this Next.js endpoint after verified product webhooks/admin changes.
SHOPIFY_REVALIDATION_URL=http://localhost:3000/api/catalog/revalidate
# Set the SAME random value on both Express and Next.js. Server-only.
SHOPIFY_REVALIDATION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local admin provisioning only; do not add to Vercel runtime settings.
ADMIN_NAME=replace-with-admin-name
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-unique-admin-password
