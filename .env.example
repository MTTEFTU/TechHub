# Copy this file to .env in the repository root and replace placeholders locally.

MONGODB_URI=replace-with-mongodb-connection-string
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=replace-with-local-port
CLIENT_URL=replace-with-frontend-origin
NEXT_PUBLIC_API_URL=replace-with-api-base-url
NEXT_PUBLIC_SITE_URL=replace-with-frontend-origin

# Shopify Headless / Storefront API. Keep tokens and secrets server-side only.
SHOPIFY_STORE_DOMAIN=replace-with-store-name.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-access-token
SHOPIFY_WEBHOOK_SECRET=replace-with-shopify-webhook-secret
SHOPIFY_API_VERSION=replace-with-shopify-api-version

# Used only when running `npm run admin:create`; keep these out of deployment config.
ADMIN_NAME=replace-with-admin-name
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-unique-admin-password
